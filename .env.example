# Local default target:
# - .env.local is intended for local Supabase values.
# - .env.staging is intended for remote staging values.
# Copy this template to whichever target file you are preparing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox access token for the `location` Edge Function only (set on Supabase as secret
# MAPBOX_ACCESS_TOKEN; do not prefix with VITE_ — never expose this token to the browser).
MAPBOX_ACCESS_TOKEN=
