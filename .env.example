# Local default target:
# - .env.local is intended for local Supabase values.
# - .env.staging is intended for remote staging values.
# Copy this template to whichever target file you are preparing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Prelaunch landing mode: intake routes only; marketplace routes redirect to home.
# Set to false when re-enabling search, auth, dashboard, etc.
VITE_PRELAUNCH_MODE=true

# Geoapify API key for the `location` Edge Function only (set on Supabase as secret
# GEOAPIFY_API_KEY; do not prefix with VITE_ — never expose this key to the browser).
# CLI: `supabase secrets set GEOAPIFY_API_KEY=...` on the linked project.
GEOAPIFY_API_KEY=
